    "# BMI Calculator\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "aa489d9f-3e96-4d0a-ad44-d04d16e3ed3a",
   "metadata": {},
   "outputs": [
