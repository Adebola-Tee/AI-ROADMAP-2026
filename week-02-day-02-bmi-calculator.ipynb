   ],
   "source": [
    "name = input (\"Enter your name:\")\n",
    "weight = float(input(\"Enter your weight:\"))\n",
    "height = float(input(\"Enter your height:\"))\n",
    "BMI_calculator = weight / (height *height)\n",
    "print (f\"{name} your BMI is {BMI_calculator:.2f}\")"
   ]
